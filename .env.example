# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/smarteval
SQLITE_URL=sqlite:///./smarteval.db  # Fallback for easy local development without PostgreSQL
USE_SQLITE=True                       # Toggle to True to run database operations locally with zero configuration

# Redis and Task Queue Configuration
REDIS_URL=redis://redis:6379/0

# Security
JWT_SECRET_KEY=949f28c5a2c4e20798e4d372fa05b8cf0f230da37194f4a3de07b6bf89ab1e6d
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI APIs
OPENAI_API_KEY=your_openai_api_key_here
USE_MOCK_AI=True  # Set to False to use live EasyOCR and OpenAI API

# System Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
